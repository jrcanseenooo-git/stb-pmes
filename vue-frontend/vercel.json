{
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://stb-pmes.vercel.app" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

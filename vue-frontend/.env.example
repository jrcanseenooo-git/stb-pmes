# ─────────────────────────────────────────────
# PMES Frontend – Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Firebase (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restrict sign-in to this email domain
VITE_ALLOWED_EMAIL_DOMAIN=dswd.gov.ph

# Google Apps Script deployed web app URL.
# Local dev uses this through the Vite /gas proxy.
# Production should set this server-side too as GAS_WEB_APP_URL.
VITE_API_BASE_URL=

# Optional production proxy path. Leave blank unless the API proxy is hosted
# somewhere other than this same Vercel app.
VITE_API_PROXY_URL=

# Server-side only in Vercel. Comma-separated approved browser origins.
PMES_ALLOWED_ORIGINS=

# App metadata
VITE_APP_NAME=PMES
VITE_APP_BUREAU=Social Technology Bureau
